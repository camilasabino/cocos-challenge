# Copy to `.env` (git-ignored) before running anything:  cp .env.example .env
# These are throwaway credentials for the local Docker Compose database only.

# --- Docker Compose (local PostgreSQL) ---
POSTGRES_USER=cocos
POSTGRES_PASSWORD=cocos_local_password
POSTGRES_PORT=5432
# Host port for the optional `app` Compose service (the production image).
APP_PORT=3000

# --- Application ---
# Keep user/password/port consistent with the values above.
DATABASE_URL=postgresql://cocos:cocos_local_password@localhost:5432/cocos
PORT=3000
# Max time an order placement waits for the per-user row lock.
DB_LOCK_TIMEOUT_MS=5000
# Connection pool: size, and how long a request waits for a free connection
# before failing with 503 instead of queueing indefinitely.
DB_POOL_MAX=10
DB_POOL_ACQUIRE_TIMEOUT_MS=5000

# --- Tests ---
# Must point to the database named `cocos_test`; the test setup refuses anything else.
TEST_DATABASE_URL=postgresql://cocos:cocos_local_password@localhost:5432/cocos_test
