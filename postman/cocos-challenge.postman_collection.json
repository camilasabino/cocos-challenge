{
  "info": {
    "name": "Cocos Challenge API",
    "description": "Requests for the brokerage API. Set `baseUrl` (collection variable). IDs match the local demo database (users 1 = active, 2 = empty, 3 = oversold; instruments 1 ARS, 2 NRTE, 4 SOLA, 5 LUMI, 6 MARB, 7 TERR without market data). Against another dataset, look the ids up with *Instruments / Search* and adjust the variables.\n\n**Requests marked MODIFIES DATABASE STATE insert rows into `orders`.** Run them against a disposable database, or against the demo database only if you accept extra rows (use `docker compose down -v && npm run db:up` to reset). The Swagger UI is at `{{baseUrl}}/api`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "emptyUserId",
      "value": "2",
      "type": "string"
    },
    {
      "key": "oversoldUserId",
      "value": "3",
      "type": "string"
    },
    {
      "key": "arsId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "nrteId",
      "value": "2",
      "type": "string"
    },
    {
      "key": "solaId",
      "value": "4",
      "type": "string"
    },
    {
      "key": "lumiId",
      "value": "5",
      "type": "string"
    },
    {
      "key": "marbId",
      "value": "6",
      "type": "string"
    },
    {
      "key": "terrId",
      "value": "7",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Readiness: 200 only while PostgreSQL is reachable.",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response body', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.eql({ status: 'ok' });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
